# Vercel Dashboard → Project → Settings → Environment Variables 에 등록하세요.
# (이 파일이나 vercel.json 에 실제 키를 적지 마세요. 저장소가 공개되어 있습니다.)

# 토스페이먼츠 개발자센터 → API 키 → 자동결제(빌링) 시크릿 키
TOSS_SECRET_KEY=test_sk_xxxxxxxx

# Firebase 콘솔 → 프로젝트 설정 → 서비스 계정 → 새 비공개 키 생성 → JSON 내용을 그대로 붙여넣기
FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# 자동결제 갱신(Vercel Cron) 호출 보호용 임의의 긴 문자열
CRON_SECRET=change-me-to-a-long-random-string

# (선택) 결제 후 돌아올 주소. 비워 두면 요청한 도메인을 사용합니다.
SITE_URL=https://soccer-lesson-manager-saas.vercel.app
